# Copy to .env and fill in. Never commit .env.
DB_URI=mysql+pymysql://USER:PASSWORD@HOST:4000/DBNAME?ssl_verify_cert=true&ssl_verify_identity=true

# Alpaca (free paper account). One key pair is used by both the live stream and the backfill.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_MAX_SYMBOLS=30            # free plan WebSocket limit

# AI model
LLM_PROVIDER=groq                # groq | ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK=ollama              # used when Groq is missing/down/over budget
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL_NAME=phi3:mini
LLM_DAILY_BUDGET=900             # Groq free tier is ~1,000 requests/day
# per-purpose budgets: LLM_BUDGET_CHAT=350 LLM_BUDGET_NEWS=200 LLM_BUDGET_RELATIONSHIPS=200 LLM_BUDGET_COUNCIL=120
# RESEARCH_CYCLE_HOURS=24  COUNCIL_REFRESH_HOURS=6   (defaults when LLM_PROVIDER=groq)

# RAG embeddings
EMBED_PROVIDER=ollama            # ollama (local) | fastembed (inside Docker, for hosting)

# SEC EDGAR identification
SEC_USER_AGENT=Your Name your@email.com

# Hosting
ORACLE_ENV=development           # production hides /api/debug and restricts CORS
ALLOWED_ORIGINS=http://localhost
