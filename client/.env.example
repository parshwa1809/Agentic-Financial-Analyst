# Example environment variables for the frontend
# Build-time (Vite) variable used when you run `npm run build` locally
VITE_API_BASE=http://localhost:8000/api

# Runtime variable (used when running the nginx container)
# The entrypoint writes a small `runtime-config.js` that the SPA will read at startup.
# When using docker-compose with the backend service named `api`, set:
# RUNTIME_API_BASE=http://api:8000/api
RUNTIME_API_BASE=
